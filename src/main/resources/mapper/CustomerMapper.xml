<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.project4.mapper.CustomerMapper">

    <!-- 전체 조회 -->
    <select id="findAll"
            resultType="com.example.project4.domain.Customer">

        SELECT
        customer_id,
        name,
        email,
        created_at
        FROM customers
        ORDER BY customer_id DESC

    </select>

    <!-- ID로 조회 -->
    <select id="findById"
            resultType="com.example.project4.domain.Customer">

        SELECT
        customer_id,
        name,
        email,
        created_at
        FROM customers
        WHERE customer_id = #{customerId}

    </select>

    <!-- 이메일 중복 조회 -->
    <select id="findByEmail"
            resultType="com.example.project4.domain.Customer">

        SELECT
        customer_id,
        name,
        email,
        created_at
        FROM customers
        WHERE email = #{email}

    </select>

    <!-- 등록 -->
    <insert id="insert"
            parameterType="com.example.project4.domain.Customer"
            useGeneratedKeys="true"
            keyProperty="customerId"
            keyColumn="customer_id">

        INSERT INTO customers (
        name,
        email
        )
        VALUES (
        #{name},
        #{email}
        )

    </insert>

    <!-- 수정 -->
    <update id="update"
            parameterType="com.example.project4.domain.Customer">

        UPDATE customers
        SET
        name = #{name},
        email = #{email}
        WHERE customer_id = #{customerId}

    </update>

    <!-- 삭제 -->
    <delete id="delete">

        DELETE FROM customers
        WHERE customer_id = #{customerId}

    </delete>

</mapper>